{
  "uid": "telemetry-stream",
  "title": "Telemetry Stream",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "kafka",
    "mongodb"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(telemetry_events_received_total[1m]))",
          "legendFormat": "received",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(telemetry_events_stored_total[1m]))",
          "legendFormat": "stored",
          "exemplar": true
        },
        {
          "refId": "C",
          "expr": "sum(rate(telemetry_events_duplicate_total[1m]))",
          "legendFormat": "duplicate",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Batch latency (p50 / p95 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(telemetry_process_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(telemetry_process_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(telemetry_process_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumer lag (max records)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (topic) (kafka_consumer_fetch_manager_records_lag_max)",
          "legendFormat": "{{topic}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Alerts raised per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(telemetry_alerts_raised_total[5m])) * 60",
          "legendFormat": "alerts",
          "exemplar": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Batch errors per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(telemetry_process_seconds_count{error!=\"none\"}[5m])) * 60",
          "legendFormat": "errors",
          "exemplar": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "heap",
          "exemplar": true
        }
      ]
    }
  ]
}
