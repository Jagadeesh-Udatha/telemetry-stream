{
  "type": "record",
  "name": "GpsReading",
  "namespace": "dev.jagadeesh.telemetry.avro",
  "doc": "One GPS reading from a vehicle on telemetry.raw.avro. v2 added fuelPct. Subject telemetry.raw.avro-value is BACKWARD compatible: new fields need a default.",
  "fields": [
    {"name": "eventId", "type": "string"},
    {"name": "vehicleId", "type": "string"},
    {"name": "ts", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "lat", "type": "double"},
    {"name": "lon", "type": "double"},
    {"name": "speedKph", "type": "double"},
    {"name": "heading", "type": "double"},
    {"name": "fuelPct", "type": ["null", "double"], "default": null, "doc": "v2: fuel level 0-100; null when an older device sent a v1 record"}
  ]
}
